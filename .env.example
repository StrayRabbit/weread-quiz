# ═════════════════════════════════════════════════════════════════
#  ① 填下面这三行 —— 密钥在模型供应商的后台拿
#  ② 保存这个文件
#  ③ 双击 启动PK.bat
# ═════════════════════════════════════════════════════════════════
#
# 主模型（必填）—— 文本路径用它。协议（OpenAI 兼容 / 决策模型）程序自己认。
#
#   DeepSeek    https://api.deepseek.com/v1            deepseek-chat
#   MiniMax     https://api.minimaxi.com/v1             MiniMax-Text-01
#   智谱 GLM    https://open.bigmodel.cn/api/paas/v4    glm-xxx
#   Kimi        https://api.moonshot.cn/v1              kimi-xxx
#   硅基流动     https://api.siliconflow.cn/v1           Qwen/Qwen2.5-VL-72B-Instruct
#
# 决策模型也填这三行 —— 它更快更便宜（阿里百炼的 decision-model-preview
# 目前限免），但读不了图：
#
#   阿里百炼    https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#               decision-model-preview
#   Jev        https://jevmodel.org/v1/systemone
#               jev-latest

MODEL_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=sk-xxxxxxxx
MODEL_NAME=decision-model-preview


# PK 文本路径（判下标）的单次上限（秒）。默认 5.0；
PK_TEXT_TIMEOUT=6.5
