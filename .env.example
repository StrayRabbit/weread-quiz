# 模型 API（OpenAI 兼容协议，必填）—— 换供应商只改这三行
MODEL_BASE_URL=https://api.minimaxi.com/v1
MODEL_API_KEY=sk-xxxxxxxx
MODEL_NAME=MiniMax-M3.1-Flash

# 其它供应商参考（端点需支持图片输入；MiniMax 路径不带 /anthropic）：
#   DeepSeek   https://api.deepseek.com/v1              deepseek-chat
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4     glm-4v-plus
#   Kimi       https://api.moonshot.cn/v1               moonshot-v1-32k
#   硅基流动   https://api.siliconflow.cn/v1            Qwen/Qwen2.5-VL-72B-Instruct

# 模型是否输出思考块。PK 不要关：实测快 312ms/题，但 10 道真实题里 2 道的答案会变
MODEL_THINKING=1

# 视觉请求失败后的重试次数。PK 预算紧，重试 2 次必然超时
VISION_RETRIES=1

# 模型失败或超时时是否蒙第一个按钮（惩罚与答错相同，蒙有 25~33% 机会）。daily 不读此项
GUESS_ON_FAILURE=1

# 本地 OCR 最低置信度（0~1），低于阈值转图片路径。daily 独立，用下一项
OCR_MIN_CONFIDENCE=0.7
DAILY_OCR_MIN_CONFIDENCE=0.85

# PK 点击后开始检查下一题的固定延迟（秒）
PK_NEXT_QUESTION_DELAY=1.0

# PK 本地 OCR 连续判否后，允许一次视觉兜底的等待时间（秒）；0 表示关闭
PK_OCR_FALLBACK_SECONDS=3.0
