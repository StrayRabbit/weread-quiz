# 模型 API（OpenAI 兼容协议，必填）—— 换供应商只改这三行
MODEL_BASE_URL=https://api.minimaxi.com/v1
MODEL_API_KEY=sk-xxxxxxxx
MODEL_NAME=xxxxxxxx

# 其它供应商参考（端点需支持图片输入；MiniMax 路径不带 /anthropic）：
#   DeepSeek   https://api.deepseek.com/v1              deepseek-xxx
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4     glm-xxx
#   Kimi       https://api.moonshot.cn/v1               moonshot-v1-32k
#   硅基流动   https://api.siliconflow.cn/v1            Qwen/Qwen2.5-VL-72B-Instruct

# 视觉模型一次调用同时完成"识别题目"和"判答案"
VISION_ENABLED=1

# 单题流程重试上限
MAX_RETRIES=2

# 视觉模型失败后的额外重试次数（总次数 = 重试 + 1）
# 0=不重试（稳，单题最坏 5.8 秒；约 10% 的题会蒙）
# 1=重试 1 次（单题最坏 11.8 秒，可能超时）
VISION_RETRIES=0

# 重试仍失败时是否蒙一个答案（点第一个按钮）
GUESS_ON_FAILURE=1

# 是否让模型开启思考
#
# 必须保持 1（开启）。2026-10-19 实测（21 道真实历史题逐题对照）：
#   thinking 开   中位 2.56s   答错 0/21
#   thinking 关   中位 1.21s   答错 3/21（另 1 次解析失败）
# 关掉的 3 道错题经查证全是"不推理就抓最近邻"：
#   「谁知明镜里」的下一句 → 答「宿昔青云志」（上一句，正确是「形影自相怜」）
#   恍__隔世              → 答「般」（正确是「如」）
# 整局换算：daily 12 题全对率从约 0.96^12 掉到 0.86^12 ≈ 16%。
#
# 注意：只看解析失败率会得出相反结论（开 6/120 vs 关 7/120，无差别）——
# 关掉 thinking 后模型照样吐合法 JSON，所以不会崩，但会答错。
# 评估这个开关必须比对**答案**，不能只比对调用是否失败。
MODEL_THINKING=1
